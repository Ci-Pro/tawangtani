PORT=3000

# Supabase (Project Settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# https://openrouter.ai/keys — key disimpan di server (BUKAN di APK)
OPENROUTER_API_KEY=

# Model gratis — ganti sesuai kebutuhan (https://openrouter.ai/models?max_price=0)
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_VISION_MODEL=google/gemini-2.0-flash-exp:free
# Cadangan bila model utama penuh/rate-limited (dipisah koma)
OPENROUTER_FALLBACK_MODELS=google/gemini-2.0-flash-exp:free,qwen/qwen-2.5-72b-instruct:free,mistralai/mistral-small-3.1-24b-instruct:free

# Token admin untuk PUT /api/products (update katalog tanpa update APK)
ADMIN_TOKEN=ganti-token-admin
