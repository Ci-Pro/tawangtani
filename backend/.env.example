PORT=3000

# Supabase (Project Settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# https://openrouter.ai/keys — key disimpan di server (BUKAN di APK)
OPENROUTER_API_KEY=

# Model gratis — ganti sesuai kebutuhan (https://openrouter.ai/models?max_price=0)
OPENROUTER_MODEL=z-ai/glm-5.2:free
OPENROUTER_VISION_MODEL=nvidia/nemotron-nano-12b-v2-vl:free
# Cadangan bila model utama penuh/rate-limited (dipisah koma)
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b:free,openai/gpt-oss-20b:free,google/gemma-4-31b-it:free

# Token admin untuk PUT /api/products (update katalog tanpa update APK)
ADMIN_TOKEN=ganti-token-admin
