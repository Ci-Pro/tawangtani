{
  "expo": {
    "name": "TAWANGTANI",
    "slug": "tawangtani",
    "owner": "cipros-team",
    "extra": {
      "eas": {
        "projectId": "d97670b3-f136-4226-9ab1-d4f60303eb16"
      }
    },
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "notification": {
      "icon": "./assets/adaptive-icon.png",
      "color": "#166534"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tawangtani.app"
    },
    "android": {
      "package": "com.tawangtani.app",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TAWANGTANI memerlukan akses lokasi untuk menampilkan cuaca di lahan Anda."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#166534"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "TAWANGTANI memerlukan akses foto untuk diagnosis tanaman (dikirim ke server AI Anda)."
        }
      ],
      [
        "expo-widget",
        {
          "android": {
            "src": "./src/widgets/android",
            "widgets": [
              {
                "name": "MarketWidgetProvider",
                "resourceName": "@xml/market_widget_info"
              }
            ]
          }
        }
      ]
    ]
  }
}
