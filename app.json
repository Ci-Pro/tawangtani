{
  "expo": {
    "name": "TAWANGTANI",
    "slug": "tawangtani",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#14532d"
    },
    "notification": {
      "icon": "./assets/adaptive-icon.png",
      "color": "#166534"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tawangtani.app"
    },
    "android": {
      "package": "com.tawangtani.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#14532d"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TAWANGTANI memerlukan akses lokasi untuk menampilkan cuaca di lahan Anda."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#166534"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "TAWANGTANI memerlukan akses foto untuk diagnosis tanaman (dikirim ke server AI Anda)."
        }
      ]
    ]
  }
}
